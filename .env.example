# QUIVER Frontend Environment Configuration
# Copy this file to .env and update the values

# API Base URL
# Development: http://localhost:8000
# Production: https://your-production-api.com
VITE_API_BASE_URL=https://quiver-f8fvbkgnftakawa0.canadacentral-01.azurewebsites.net

# App Environment
# Options: development, staging, production
VITE_APP_ENV=development

# Enable Debug Mode (shows debug OTP endpoint, etc.)
VITE_DEBUG_MODE=true

# Twilio Configuration (if needed on frontend)
# VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
# VITE_TWILIO_API_KEY=your_twilio_api_key
# VITE_TWILIO_API_SECRET=your_twilio_api_secret

# ===========================================
# OpenAI Realtime Voice Assistant
# ===========================================
# Option 1: Direct API Key (for development ONLY)
# Set this to connect directly to OpenAI Realtime API from frontend
# WARNING: This exposes your API key in the browser - use only for local development!
# VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Realtime Model (optional)
# Default: gpt-4o-realtime-preview-2024-12-17
# VITE_OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# Option 2 (Recommended for Production):
# Don't set VITE_OPENAI_API_KEY - the app will use your backend endpoints:
# - GET /auth/voice-agent/token/ - Returns ephemeral token
# - GET /auth/voice-agent/config/ - Returns session configuration
# Configure the OpenAI API key on your backend server for security.
